<Window x:Class="IDEManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IDE Manager" Height="920" Width="1480"
        Background="{StaticResource BackPrimary}" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Foreground="{StaticResource TextPrimary}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with Theme Toggle -->
        <Border Background="{StaticResource BackSecondary}" CornerRadius="14" Margin="0,0,0,16" Padding="16">
            <Grid>
                <TextBlock Text="IDE Manager" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="☀️ Light" Width="110" Height="40" Margin="0,0,10,0" Click="ThemeButton_Click"
                            Background="{StaticResource BackTertiary}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" FontWeight="SemiBold" CornerRadius="8"/>
                    <Button Content="🌙 Dark" Width="110" Height="40" Click="ThemeButton_Click"
                            Background="{StaticResource Accent}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" CornerRadius="8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Active Session Display -->
        <Border Grid.Row="1" Background="{StaticResource Accent}" CornerRadius="14" Margin="0,0,0,16" Padding="20" Visibility="{Binding IsSessionActive, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Active Session" Foreground="White" FontSize="14" Opacity="0.9" />
                    <TextBlock Text="{Binding ActiveProjectName}" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding CurrentSessionTime}" Foreground="White" FontSize="18" Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Content="Stop Session" Width="140" Height="44" VerticalAlignment="Center" Click="StopSessionButton_Click"
                        Background="White" Foreground="{StaticResource Accent}" FontWeight="Bold" BorderThickness="0" CornerRadius="8"/>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <Border Grid.Row="2" Background="{StaticResource BackSecondary}" CornerRadius="14" Margin="0,0,0,16" Padding="16">
            <StackPanel Orientation="Horizontal">
                <Button Content="+ Add Project" Width="140" Height="44" Margin="0,0,12,0" Click="AddProjectButton_Click"
                        Background="{StaticResource Accent}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" CornerRadius="8" />
                <Button Content="��� Refresh" Width="120" Height="44" Margin="0,0,12,0" Click="RefreshButton_Click"
                        Background="{StaticResource BackTertiary}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" FontWeight="SemiBold" CornerRadius="8" />
                <Button Content="▶ Open in IDE" Width="140" Height="44" Click="OpenInIdeButton_Click"
                        Background="{StaticResource Success}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" CornerRadius="8" />
            </StackPanel>
        </Border>

        <!-- Main Content Grid -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Projects and Sessions -->
            <StackPanel Margin="0,0,12,0">
                <!-- Dashboard Stats -->
                <Border Background="{StaticResource BackSecondary}" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{StaticResource BackTertiary}" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Total Projects" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="{Binding TotalProjects}" Foreground="{StaticResource TextPrimary}" FontSize="32" FontWeight="Bold" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource BackTertiary}" CornerRadius="10" Padding="14" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Total Tracked Time" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="{Binding TotalTrackedHours}" Foreground="{StaticResource Accent}" FontSize="32" FontWeight="Bold" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Projects List -->
                <Border Background="{StaticResource BackSecondary}" CornerRadius="14" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="📁 Projects" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />

                        <ListView Grid.Row="1" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}" Background="{StaticResource BackPrimary}" BorderThickness="0" Foreground="{StaticResource TextPrimary}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="140" />
                                    <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="80" />
                                    <GridViewColumn Header="Time" DisplayMemberBinding="{Binding TotalSecondsSpent}" Width="80" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Right Panel: IDE, SDK, and Sessions -->
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <!-- Active IDE Display -->
                <Border Background="{StaticResource BackSecondary}" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🖥️ Active IDE" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="16" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding ActiveIdeName}" Foreground="{StaticResource Accent}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <!-- Installed IDEs -->
                <Border Background="{StaticResource BackSecondary}" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="🔧 Available IDEs" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="16" Margin="0,0,0,12" />

                        <ListView Grid.Row="1" ItemsSource="{Binding InstalledIdeList}" SelectedItem="{Binding SelectedIde, Mode=TwoWay}" Background="{StaticResource BackPrimary}" BorderThickness="0" Height="120">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="120" />
                                    <GridViewColumn Header="Ver" DisplayMemberBinding="{Binding Version}" Width="80" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>

                <!-- SDKs -->
                <Border Background="{StaticResource BackSecondary}" CornerRadius="14" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="⚙️ Detected SDKs" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="16" Margin="0,0,0,12" />

                        <ListView Grid.Row="1" ItemsSource="{Binding InstalledSdkList}" Background="{StaticResource BackPrimary}" BorderThickness="0" Height="120">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="70" />
                                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="80" />
                                    <GridViewColumn Header="Version" DisplayMemberBinding="{Binding Version}" Width="80" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
