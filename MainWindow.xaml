<Window x:Class="IDEManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IDE Manager" Height="820" Width="1320"
        Background="#111827" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#1F2937" CornerRadius="12" Margin="0,0,0,12" Padding="12">
            <StackPanel Orientation="Horizontal">
                <Button Content="Add Project" Width="130" Height="38" Margin="0,0,12,0" Click="AddProjectButton_Click"
                        Background="#8B5CF6" Foreground="White" BorderThickness="0" FontWeight="SemiBold" />
                <Button Content="Refresh" Width="120" Height="38" Margin="0,0,12,0" Click="RefreshButton_Click"
                        Background="#374151" Foreground="White" BorderThickness="0" FontWeight="SemiBold" />
                <Button Content="Open in IDE" Width="130" Height="38" Click="OpenInIdeButton_Click"
                        Background="#374151" Foreground="White" BorderThickness="0" FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#1F2937" CornerRadius="14" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="#111827" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Total Projects" Foreground="#D1D5DB" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TotalProjects}" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#111827" CornerRadius="10" Padding="16" Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="Tracked Time" Foreground="#D1D5DB" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TotalTrackedHours}" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#111827" CornerRadius="10" Padding="16" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Active IDE" Foreground="#D1D5DB" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ActiveIdeName}" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.4*" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <Border Background="#1F2937" CornerRadius="14" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Projects" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />

                    <ListView Grid.Row="1" ItemsSource="{Binding Projects}" Background="#111827" BorderThickness="0" Foreground="White">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="180" />
                                <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="100" />
                                <GridViewColumn Header="Path" DisplayMemberBinding="{Binding Path}" Width="430" />
                                <GridViewColumn Header="Time" DisplayMemberBinding="{Binding TotalSecondsSpent}" Width="110" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <Border Background="#1F2937" CornerRadius="14" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Installed IDEs" Foreground="White" FontWeight="Bold" FontSize="18" Margin="0,0,0,8" />

                        <ListView Grid.Row="1" ItemsSource="{Binding InstalledIdeList}" Background="#111827" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="130" />
                                    <GridViewColumn Header="Version" DisplayMemberBinding="{Binding Version}" Width="90" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>

                <Border Background="#1F2937" CornerRadius="14" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="SDKs" Foreground="White" FontWeight="Bold" FontSize="18" Margin="0,0,0,8" />

                        <ListView Grid.Row="1" ItemsSource="{Binding InstalledSdkList}" Background="#111827" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="90" />
                                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="120" />
                                    <GridViewColumn Header="Version" DisplayMemberBinding="{Binding Version}" Width="110" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
