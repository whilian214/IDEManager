<Window x:Class="IDEManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IDE Manager" Height="750" Width="1250" WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Add Project" Width="120" Height="32" Margin="0,0,10,0" Click="AddProjectButton_Click" />
            <Button Content="Refresh" Width="120" Height="32" Margin="0,0,10,0" Click="RefreshButton_Click" />
            <Button Content="Open in IDE" Width="120" Height="32" Click="OpenInIdeButton_Click" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Projects" Margin="0,0,12,0">
                <ListView ItemsSource="{Binding Projects}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="180" />
                            <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="90" />
                            <GridViewColumn Header="Path" DisplayMemberBinding="{Binding Path}" Width="420" />
                            <GridViewColumn Header="Time" DisplayMemberBinding="{Binding TotalSecondsSpent}" Width="100" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>

            <StackPanel Grid.Column="1">
                <GroupBox Header="Installed IDEs" Margin="0,0,0,12">
                    <ListView ItemsSource="{Binding InstalledIdeList}" Height="260">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="150" />
                                <GridViewColumn Header="Version" DisplayMemberBinding="{Binding Version}" Width="100" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </GroupBox>

                <GroupBox Header="Installed SDKs">
                    <ListView ItemsSource="{Binding InstalledSdkList}" Height="260">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="90" />
                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="120" />
                                <GridViewColumn Header="Version" DisplayMemberBinding="{Binding Version}" Width="120" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </GroupBox>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
