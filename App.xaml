<Application x:Class="IDEManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="BackPrimary" Color="#111827"/>
            <SolidColorBrush x:Key="BackSecondary" Color="#1F2937"/>
            <SolidColorBrush x:Key="BackTertiary" Color="#374151"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#F9FAFB"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#D1D5DB"/>
            <SolidColorBrush x:Key="Accent" Color="#8B5CF6"/>
            <SolidColorBrush x:Key="AccentSoft" Color="#A78BFA"/>
            <SolidColorBrush x:Key="Border" Color="#374151"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
